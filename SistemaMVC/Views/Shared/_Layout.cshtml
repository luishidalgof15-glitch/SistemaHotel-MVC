@{
    var nombre = Context.Session.GetString("Nombre");
    var rol = Context.Session.GetString("Rol");
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema MVC</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand navbar-dark bg-primary-subtle-dark mb-4">
        <div class="container">
            <a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index">
                <i class="bi bi-building"></i> Sistema MVC
            </a>
            @if (!string.IsNullOrEmpty(nombre))
            {
                <div class="d-flex align-items-center gap-3 text-white">
                    <span><i class="bi bi-person-circle"></i> @nombre <small class="opacity-75">(@rol)</small></span>
                    <a class="btn btn-sm btn-outline-light" asp-controller="Account" asp-action="Logout">
                        <i class="bi bi-box-arrow-right"></i> Cerrar sesión
                    </a>
                </div>
            }
        </div>
    </nav>
    <main class="container pb-5">
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger">@error</div>
        }
        @RenderBody()
    </main>
    <footer class="text-center text-muted small py-3 border-top">
        Diseño y Arquitectura de Software – UPN · Prototipo ASP.NET Core MVC + SQL Server
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
